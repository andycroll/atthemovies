#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
packages=(build-essential autoconf bison libssl-dev libyaml-dev libreadline-dev zlib1g-dev libffi-dev libgdbm-dev libncurses-dev libvips42 sqlite3 git curl ca-certificates rbenv)
missing=()
for package in "${packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'install ok installed'; then
    missing+=("$package")
  fi
done
if ((${#missing[@]})); then
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing[@]}"
fi

export RBENV_ROOT="$HOME/.rbenv"
export PATH="$RBENV_ROOT/bin:$RBENV_ROOT/shims:$PATH"
eval "$(rbenv init - bash)"
version="$(cat .ruby-version)"
if [[ ! -x "$RBENV_ROOT/versions/$version/bin/ruby" ]]; then
  build_dir="$(mktemp -d)"
  trap 'rm -rf "$build_dir"' EXIT
  git clone --depth 1 https://github.com/rbenv/ruby-build.git "$build_dir/ruby-build"
  "$build_dir/ruby-build/bin/ruby-build" "$version" "$RBENV_ROOT/versions/$version"
fi
rbenv rehash
marker="# atthemovies rbenv"
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# atthemovies rbenv
export RBENV_ROOT="$HOME/.rbenv"
export PATH="$RBENV_ROOT/bin:$RBENV_ROOT/shims:$PATH"
eval "$(rbenv init - bash)"
EOF
fi

echo "==> Installing gems"
bundle check || bundle install --jobs 4 --retry 3
echo "==> Preparing SQLite databases and CSS"
bin/rails db:prepare tailwindcss:build
RAILS_ENV=test bin/rails db:prepare
echo "==> Orb setup complete"
