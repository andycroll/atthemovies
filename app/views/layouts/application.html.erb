<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <title><%= content_for(:title) || "At The Movies" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Atthemovies">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <% if @canonical_url %><%= tag.link rel: "canonical", href: @canonical_url %><% end %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-base-200 min-h-screen text-base-content">
    <header class="bg-base-100 border-b border-base-300">
      <nav class="max-w-6xl mx-auto px-5 py-5 flex flex-wrap items-center gap-5" aria-label="Main navigation">
        <%= link_to "At The Movies", root_path, class: "font-black text-xl tracking-tight mr-auto" %>
        <%= link_to "Films", films_path, class: "link link-hover" %>
        <%= link_to "Cinemas", cinemas_path, class: "link link-hover" %>
        <% if authenticated? %>
          <%= link_to "Triage", operator_films_path, class: "link link-hover" %>
          <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-ghost btn-sm" %>
        <% else %>
          <%= link_to "Operator sign in", new_session_path, class: "text-sm link link-hover" %>
        <% end %>
      </nav>
    </header>
    <main class="max-w-6xl mx-auto px-5 py-10">
      <% flash.each do |kind, message| %>
        <div role="status" class="alert <%= kind == 'alert' ? 'alert-error' : 'alert-success' %> mb-6"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
    <footer class="max-w-6xl mx-auto px-5 py-8 text-sm text-base-content/60 border-t border-base-300">
      UK cinema listings. All times are local to Europe/London. Always check with the cinema before booking.
    </footer>
  </body>
</html>
