<section class="max-w-md mx-auto bg-base-100 border border-base-300 rounded-box p-8">
  <h1 class="font-black text-3xl mb-3">Operator sign in</h1>
  <p class="text-base-content/70 mb-6">Manage films and cinema listings.</p>
  <%= form_with url: session_path, class: "grid gap-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email address", class: "block font-semibold mb-2" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input input-bordered w-full" %>
    </div>
    <div>
      <%= form.label :password, class: "block font-semibold mb-2" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input input-bordered w-full" %>
    </div>
    <%= form.submit "Sign in", class: "btn btn-primary" %>
    <%= link_to "Forgot password?", new_password_path, class: "link link-hover text-sm" %>
  <% end %>
</section>
