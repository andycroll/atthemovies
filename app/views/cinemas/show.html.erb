<% content_for :title, "#{@cinema.name} · At The Movies" %>
<%= link_to "← All cinemas", cinemas_path, class: "link link-hover text-sm" %>
<section class="bg-base-100 rounded-box border border-base-300 p-8 my-6">
  <p class="uppercase tracking-widest text-sm text-primary mb-3"><%= @cinema.brand %></p>
  <h1 class="text-4xl font-black mb-4"><%= @cinema.name %></h1>
  <p class="text-base-content/70 mb-6"><%= @cinema.address %></p>
  <% if @cinema.screenings_url.present? %><%= link_to "Cinema website ↗", @cinema.screenings_url, class: "btn btn-outline", rel: "noopener" %><% end %>
  <% if authenticated? %><%= link_to "Edit cinema", edit_operator_cinema_path(@cinema), class: "btn btn-ghost" %><% end %>
</section>
<h2 class="text-2xl font-bold mb-5">Pick a day</h2>
<%= render "performances/dates", cinema: @cinema, selected: nil %>
