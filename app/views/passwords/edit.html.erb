<section class="max-w-md mx-auto bg-base-100 border border-base-300 rounded-box p-8">
  <h1 class="font-black text-3xl mb-6">Update your password</h1>
  <%= form_with url: password_path(params[:token]), method: :put, class: "grid gap-5" do |form| %>
    <div>
      <%= form.label :password, "New password", class: "block font-semibold mb-2" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "input input-bordered w-full" %>
    </div>
    <div>
      <%= form.label :password_confirmation, "Repeat new password", class: "block font-semibold mb-2" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input input-bordered w-full" %>
    </div>
    <%= form.submit "Save", class: "btn btn-primary" %>
  <% end %>
</section>
